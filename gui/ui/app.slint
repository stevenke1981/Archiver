import { Button, ComboBox, LineEdit, Slider, CheckBox, ProgressIndicator, ScrollView, ListView } from "std-widgets.slint";

export struct Row {
    name: string,
    size: string,
    packed: string,
    kind: string,
    modified: string,
    crc: string,
    // 0 parent, 1 folder, 2 file, 3 archive, 4 exe, 5 text, 6 image
    icon: int,
    selected: bool,
}

component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    callback clicked;
    width: 54px;
    height: 56px;
    border-radius: 3px;
    background: ta.has-hover && root.enabled ? (ta.pressed ? #cce4f7 : #e5f1fb) : root.checked ? #cce4f7 : transparent;
    border-width: (ta.has-hover && root.enabled) || root.checked ? 1px : 0px;
    border-color: #99c9ef;
    VerticalLayout {
        padding: 3px;
        spacing: 2px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 32px;
                height: 32px;
                opacity: root.enabled ? 1.0 : 0.3;
            }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 12px;
            color: root.enabled ? #000 : #a0a0a0;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <int> column;
    in property <int> sort-column;
    in property <bool> sort-ascending;
    in property <bool> align-right: false;
    callback sort(int);
    background: hta.has-hover ? #e5f1fb : #ffffff;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: #e5e5e5;
    }
    Text {
        x: 6px;
        width: parent.width - 12px;
        text: root.text;
        vertical-alignment: center;
        horizontal-alignment: root.align-right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        font-size: 12px;
        overflow: elide;
    }
    if root.sort-column == root.column: Text {
        y: -1px;
        x: (parent.width - self.width) / 2;
        text: root.sort-ascending ? "˄" : "˅";
        font-size: 9px;
        color: #808080;
    }
    hta := TouchArea {
        clicked => { root.sort(root.column); }
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("icons/app.svg");
    preferred-width: 1000px;
    preferred-height: 560px;
    min-width: 640px;
    min-height: 380px;
    background: #ffffff;
    default-font-size: 12px;

    in property <string> window-title: "Archiver";
    in property <[Row]> rows;
    in property <string> path-text;
    in property <string> status-left;
    in property <string> status-right;
    in property <bool> archive-open;
    in property <bool> can-delete;
    in property <bool> can-extract-selection;
    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;

    // background job
    in property <bool> busy;
    in property <float> progress;
    in property <string> progress-text;

    // dialogs: "", "create", "info", "shell", "find"
    in-out property <string> dialog: "";
    in property <string> create-sources;
    in property <[string]> formats;
    in-out property <int> format-index;
    in-out property <float> level: 6;
    in property <float> level-min: 0;
    in property <float> level-max: 9;
    in property <bool> level-enabled: true;
    in property <bool> password-enabled: true;
    in property <bool> single-file-warning: false;
    in-out property <string> create-password;
    in-out property <string> create-output;
    in property <string> info-text;
    in-out property <bool> shell-enabled;
    in property <string> shell-description;
    in-out property <string> find-text;
    in-out property <string> archive-password;
    in-out property <bool> create-each: false;

    // preview pane; mode: "none", "loading", "text", "hex", "image", "folder", "info", "error"
    in-out property <bool> preview-visible: true;
    in property <string> preview-mode: "none";
    in property <string> preview-title;
    in property <string> preview-meta;
    in property <string> preview-text;
    in property <image> preview-image;
    in property <string> mono-font: "monospace";

    callback action(string);
    callback row-clicked(int, bool, bool);
    callback row-double-clicked(int);
    callback row-context-requested(int) -> bool;
    callback sort(int);
    callback format-changed(int);
    callback shell-toggled(bool);
    callback key(string);

    property <length> w-size: 92px;
    property <length> w-packed: 92px;
    property <length> w-kind: 130px;
    property <length> w-date: 140px;
    property <length> w-crc: 80px;
    property <length> row-height: 20px;

    /// Scroll the file list so that row `i` is visible.
    public function ensure-row-visible(i: int) {
        if (i * root.row-height < -lv.content-y) {
            lv.content-y = -(i * root.row-height);
        } else if ((i + 1) * root.row-height > -lv.content-y + lv.visible-height) {
            lv.content-y = -((i + 1) * root.row-height - lv.visible-height);
        }
    }

    MenuBar {
        Menu {
            title: "檔案(F)";
            MenuItem { title: "開啟壓縮檔…"; activated => { root.action("open"); } }
            MenuItem { title: "新增壓縮檔…"; activated => { root.action("add"); } }
            MenuSeparator { }
            MenuItem { title: "壓縮檔密碼…"; activated => { root.action("password"); } }
            MenuItem { title: "全選"; activated => { root.action("select-all"); } }
            MenuSeparator { }
            MenuItem { title: "結束"; activated => { root.action("exit"); } }
        }
        Menu {
            title: "指令(C)";
            MenuItem { title: "加入檔案到壓縮檔"; activated => { root.action("add"); } }
            MenuItem { title: "分批壓縮（各自建立壓縮檔）…"; activated => { root.action("add-each"); } }
            MenuSeparator { }
            if !root.archive-open: MenuItem { title: "解壓縮至…"; enabled: !root.busy; activated => { root.action("extract"); } }
            MenuItem { title: "解壓縮選取項目…"; enabled: root.can-extract-selection && !root.busy; activated => { root.action("extract-selected"); } }
            MenuItem { title: "解壓縮全部…"; enabled: root.archive-open && !root.busy; activated => { root.action("extract-all"); } }
            MenuItem { title: "解壓縮到這裡"; activated => { root.action("extract-here"); } }
            MenuItem { title: "分別解壓縮到各自資料夾"; activated => { root.action("extract-each"); } }
            MenuSeparator { }
            MenuItem { title: "測試壓縮檔"; activated => { root.action("test"); } }
            MenuItem { title: "檢視檔案 (F3)"; activated => { root.action("view"); } }
            MenuItem { title: "複製到剪貼簿 (Ctrl+C)"; activated => { root.action("copy"); } }
            MenuItem { title: "刪除檔案"; enabled: root.can-delete; activated => { root.action("delete"); } }
        }
        Menu {
            title: "工具(S)";
            MenuItem { title: "精靈"; activated => { root.action("wizard"); } }
            MenuItem { title: "尋找檔案 (Ctrl+F)"; activated => { root.action("find"); } }
            MenuItem { title: "重新整理 (F5)"; activated => { root.action("refresh"); } }
            MenuItem { title: "顯示資訊"; activated => { root.action("info"); } }
        }
        Menu {
            title: "我的最愛(O)";
            MenuItem { title: "（尚無項目）"; enabled: false; }
        }
        Menu {
            title: "選項(N)";
            MenuItem { title: "預覽窗格"; checkable: true; checked <=> root.preview-visible; activated => { root.action("preview-changed"); } }
            MenuItem { title: "右鍵選單整合…"; activated => { root.action("shell"); } }
        }
        Menu {
            title: "說明(H)";
            MenuItem { title: "關於 Archiver"; activated => { root.action("about"); } }
        }
    }

    VerticalLayout {
        spacing: 0;
        // toolbar
        Rectangle {
            height: 62px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 2px;
                alignment: start;
                ToolButton { icon: @image-url("icons/add.svg"); label: "加入"; clicked => { root.action("add"); } }
                ToolButton {
                    icon: @image-url("icons/extract.svg");
                    label: root.archive-open ? "解壓選取" : "解壓縮至";
                    enabled: !root.busy && (!root.archive-open || root.can-extract-selection);
                    clicked => { root.action(root.archive-open ? "extract-selected" : "extract"); }
                }
                ToolButton { icon: @image-url("icons/test.svg"); label: "測試"; clicked => { root.action("test"); } }
                ToolButton { icon: @image-url("icons/view.svg"); label: "檢視"; clicked => { root.action("view"); } }
                ToolButton { icon: @image-url("icons/copy.svg"); label: "複製"; clicked => { root.action("copy"); } }
                ToolButton { icon: @image-url("icons/delete.svg"); label: "刪除"; enabled: root.can-delete; clicked => { root.action("delete"); } }
                ToolButton { icon: @image-url("icons/find.svg"); label: "尋找"; clicked => { root.action("find"); } }
                ToolButton { icon: @image-url("icons/wizard.svg"); label: "精靈"; clicked => { root.action("wizard"); } }
                ToolButton { icon: @image-url("icons/info.svg"); label: "資訊"; clicked => { root.action("info"); } }
                ToolButton {
                    icon: @image-url("icons/preview.svg");
                    label: "預覽";
                    checked: root.preview-visible;
                    clicked => {
                        root.preview-visible = !root.preview-visible;
                        root.action("preview-changed");
                    }
                }
                Rectangle { width: 9px; Rectangle { x: 4px; width: 1px; height: 46px; background: #d0d0d0; } }
                ToolButton { icon: @image-url("icons/antivirus.svg"); label: "防毒"; enabled: false; }
                ToolButton { icon: @image-url("icons/comment.svg"); label: "註解"; enabled: false; }
                ToolButton { icon: @image-url("icons/sfx.svg"); label: "自解"; enabled: false; }
            }
        }
        // path bar
        Rectangle {
            height: 26px;
            background: #f0f0f0;
            HorizontalLayout {
                padding: 2px;
                spacing: 4px;
                Rectangle {
                    width: 24px;
                    border-radius: 2px;
                    background: upta.has-hover ? #e5f1fb : transparent;
                    Image { source: @image-url("icons/up.svg"); width: 16px; height: 16px; }
                    upta := TouchArea { clicked => { root.action("up"); } }
                }
                Rectangle {
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #7a7a7a;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 4px;
                        Image {
                            width: 16px;
                            source: root.archive-open ? @image-url("icons/archive.svg") : @image-url("icons/folder.svg");
                        }
                        Text { text: root.path-text; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;
            VerticalLayout {
                spacing: 0;
                // header
                Rectangle {
                    height: 22px;
                    background: #ffffff;
                    HorizontalLayout {
                        HeaderCell { text: "名稱"; column: 0; sort-column: root.sort-column; sort-ascending: root.sort-ascending; sort(c) => { root.sort(c); } }
                        HeaderCell { width: root.w-size; text: "大小"; align-right: true; column: 1; sort-column: root.sort-column; sort-ascending: root.sort-ascending; sort(c) => { root.sort(c); } }
                        HeaderCell { width: root.w-packed; text: "封裝後"; align-right: true; column: 2; sort-column: root.sort-column; sort-ascending: root.sort-ascending; sort(c) => { root.sort(c); } }
                        HeaderCell { width: root.w-kind; text: "類型"; column: 3; sort-column: root.sort-column; sort-ascending: root.sort-ascending; sort(c) => { root.sort(c); } }
                        HeaderCell { width: root.w-date; text: "修改日期"; column: 4; sort-column: root.sort-column; sort-ascending: root.sort-ascending; sort(c) => { root.sort(c); } }
                        HeaderCell { width: root.w-crc; text: "CRC32"; column: 5; sort-column: root.sort-column; sort-ascending: root.sort-ascending; sort(c) => { root.sort(c); } }
                    }
                }
                // file list
                fs := FocusScope {
                    vertical-stretch: 1;
                    key-pressed(event) => {
                        if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                            if (root.can-extract-selection && !root.busy) { extract-menu.show({ x: 8px, y: 8px }); }
                            return accept;
                        }
                        if (event.text == Key.Return) { root.key("enter"); return accept; }
                        if (event.text == Key.Backspace) { root.key("up"); return accept; }
                        if (event.text == Key.Delete) { root.key("delete"); return accept; }
                        if (event.text == Key.UpArrow) { root.key("prev"); return accept; }
                        if (event.text == Key.DownArrow) { root.key("next"); return accept; }
                        if (event.text == Key.F5) { root.action("refresh"); return accept; }
                        if (event.text == Key.F3) { root.action("view"); return accept; }
                        if (event.modifiers.control && (event.text == "a" || event.text == "A")) { root.action("select-all"); return accept; }
                        if (event.modifiers.control && (event.text == "c" || event.text == "C")) { root.action("copy"); return accept; }
                        if (event.modifiers.control && (event.text == "f" || event.text == "F")) { root.action("find"); return accept; }
                        reject
                    }
                    // Open explicitly after the row callback has established the selection.
                    // A zero-size area avoids treating empty list space as an entry.
                    extract-menu := ContextMenuArea {
                        width: 0px;
                        height: 0px;
                        Menu {
                            MenuItem {
                                title: "解壓縮至…";
                                enabled: root.can-extract-selection && !root.busy;
                                activated => { root.action("extract-selected"); fs.focus(); }
                            }
                        }
                    }
                    lv := ListView {
                        for row[i] in root.rows: Rectangle {
                            height: root.row-height;
                            background: row.selected ? #cce8ff : (rta.has-hover ? #e5f3ff : transparent);
                            HorizontalLayout {
                                padding-left: 4px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Image {
                                        width: 16px;
                                        height: 16px;
                                        y: 2px;
                                        source: row.icon <= 1 ? @image-url("icons/folder.svg")
                                            : row.icon == 3 ? @image-url("icons/archive.svg")
                                            : row.icon == 4 ? @image-url("icons/exe.svg")
                                            : row.icon == 5 ? @image-url("icons/text.svg")
                                            : row.icon == 6 ? @image-url("icons/image.svg")
                                            : @image-url("icons/file.svg");
                                    }
                                    Text { text: row.name; vertical-alignment: center; overflow: elide; }
                                }
                                Text { width: root.w-size - 6px; text: row.size; horizontal-alignment: right; vertical-alignment: center; }
                                Rectangle { width: 6px; }
                                Text { width: root.w-packed - 6px; text: row.packed; horizontal-alignment: right; vertical-alignment: center; }
                                Rectangle { width: 12px; }
                                Text { width: root.w-kind - 6px; text: row.kind; vertical-alignment: center; overflow: elide; }
                                Rectangle { width: 6px; }
                                Text { width: root.w-date - 6px; text: row.modified; vertical-alignment: center; overflow: elide; }
                                Rectangle { width: 6px; }
                                Text { width: root.w-crc - 6px; text: row.crc; vertical-alignment: center; }
                            }
                            rta := TouchArea {
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                        fs.focus();
                                        root.row-clicked(i, ev.modifiers.control || ev.modifiers.meta, ev.modifiers.shift);
                                    }
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        fs.focus();
                                        if (root.row-context-requested(i)) {
                                            extract-menu.show({ x: self.mouse-x, y: i * root.row-height + lv.content-y + self.mouse-y });
                                        }
                                    }
                                }
                                double-clicked => { root.row-double-clicked(i); }
                            }
                        }
                    }
                }
            }
            if root.preview-visible: Rectangle { width: 1px; background: #d9d9d9; }
            // preview pane
            if root.preview-visible: Rectangle {
                width: 300px;
                background: #f9f9f9;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text { text: root.preview-title == "" ? "預覽" : root.preview-title; font-weight: 700; overflow: elide; }
                    if root.preview-meta != "": Text { text: root.preview-meta; color: #606060; wrap: word-wrap; }
                    Rectangle {
                        vertical-stretch: 1;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #d9d9d9;
                        clip: true;
                        if root.preview-mode == "none" || root.preview-mode == "loading": Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.preview-mode == "loading" ? "載入中…" : "選取檔案即可預覽";
                            color: #909090;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if root.preview-mode == "text": tsv := ScrollView {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            content-width: self.visible-width;
                            content-height: tt.preferred-height + 8px;
                            tt := Text {
                                x: 4px;
                                y: 4px;
                                width: tsv.visible-width - 8px;
                                text: root.preview-text;
                                wrap: word-wrap;
                            }
                        }
                        if root.preview-mode == "hex": hsv := ScrollView {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            content-width: max(self.visible-width, ht.preferred-width + 8px);
                            content-height: ht.preferred-height + 8px;
                            ht := Text {
                                x: 4px;
                                y: 4px;
                                text: root.preview-text;
                                font-family: root.mono-font;
                                font-size: 11px;
                            }
                        }
                        if root.preview-mode == "image": Image {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            source: root.preview-image;
                            image-fit: contain;
                        }
                        if root.preview-mode == "folder" || root.preview-mode == "info" || root.preview-mode == "error": Text {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            text: root.preview-text;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            color: root.preview-mode == "error" ? #c42b1c : #202020;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "複製檔案"; enabled: root.preview-mode != "none"; clicked => { root.action("copy"); } }
                        Button { text: "複製文字"; enabled: root.preview-mode == "text" || root.preview-mode == "hex"; clicked => { root.action("copy-text"); } }
                        Button { text: "開啟"; enabled: root.preview-mode != "none" && root.preview-mode != "folder" && root.preview-mode != "info"; clicked => { root.action("view"); } }
                    }
                }
            }
        }
        // status bar
        Rectangle {
            height: 24px;
            background: #f0f0f0;
            Rectangle { y: 0; height: 1px; background: #d9d9d9; }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text { text: root.status-left; vertical-alignment: center; overflow: elide; }
                Text { text: root.status-right; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
            }
            if root.busy: Rectangle {
                background: #f0f0f0;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 8px;
                    Text { text: root.progress-text; vertical-alignment: center; overflow: elide; width: 40%; }
                    ProgressIndicator { progress: root.progress; height: 14px; y: 5px; }
                    Button { text: "取消"; height: 22px; clicked => { root.action("cancel"); } }
                }
            }
        }
    }

    // ------------------------------------------------------------------ dialogs
    if root.dialog != "": Rectangle {
        background: #00000040;
        TouchArea { }
        Rectangle {
            width: root.dialog == "create" ? 560px : 440px;
            height: dlg.preferred-height;
            background: #f9f9f9;
            border-width: 1px;
            border-color: #8a8a8a;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000060;
            dlg := VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Text {
                    font-size: 15px;
                    font-weight: 600;
                    text: root.dialog == "create" ? (root.create-each ? "分批壓縮" : "建立壓縮檔")
                        : root.dialog == "info" ? "壓縮檔資訊"
                        : root.dialog == "shell" ? "右鍵選單整合"
                        : root.dialog == "password" ? "輸入密碼"
                        : "尋找檔案";
                }
                if root.dialog == "create": VerticalLayout {
                    spacing: 8px;
                    Text { text: "來源（可拖曳更多檔案進來）："; }
                    Rectangle {
                        height: 70px;
                        background: white;
                        border-width: 1px;
                        border-color: #c0c0c0;
                        ScrollView {
                            Text { x: 4px; y: 2px; text: root.create-sources; }
                        }
                    }
                    CheckBox {
                        text: "每個檔案／資料夾分別建立壓縮檔（分批壓縮）";
                        checked <=> root.create-each;
                        toggled => { root.action("create-each-changed"); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "格式："; vertical-alignment: center; width: 80px; }
                        ComboBox {
                            model: root.formats;
                            current-index <=> root.format-index;
                            selected => { root.format-changed(self.current-index); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "壓縮等級："; vertical-alignment: center; width: 80px; }
                        Slider {
                            enabled: root.level-enabled;
                            minimum: root.level-min;
                            maximum: root.level-max;
                            step: 1;
                            value <=> root.level;
                        }
                        Text { width: 60px; vertical-alignment: center; text: root.level-enabled ? round(root.level) : "（不壓縮）"; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "密碼："; vertical-alignment: center; width: 80px; }
                        LineEdit {
                            enabled: root.password-enabled;
                            input-type: password;
                            placeholder-text: root.password-enabled ? "（選用，AES-256）" : "此格式不支援密碼";
                            text <=> root.create-password;
                        }
                    }
                    if root.single-file-warning: Text { text: "⚠ 此格式只能壓縮單一檔案，多個檔案請用 TAR.* 格式"; color: #b9770e; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.create-each ? "輸出資料夾：" : "輸出："; vertical-alignment: center; width: 80px; }
                        LineEdit { text <=> root.create-output; }
                        Button { text: "瀏覽…"; clicked => { root.action("create-browse"); } }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button { text: "確定"; primary: true; clicked => { root.action("create-ok"); } }
                        Button { text: "取消"; clicked => { root.action("dialog-close"); } }
                    }
                }
                if root.dialog == "info": VerticalLayout {
                    spacing: 8px;
                    Text { text: root.info-text; wrap: word-wrap; }
                    HorizontalLayout { alignment: end; Button { text: "確定"; clicked => { root.action("dialog-close"); } } }
                }
                if root.dialog == "shell": VerticalLayout {
                    spacing: 8px;
                    Text { text: root.shell-description; wrap: word-wrap; }
                    CheckBox {
                        text: "在檔案總管 / 檔案管理員的右鍵選單中顯示 Archiver";
                        checked <=> root.shell-enabled;
                        toggled => { root.shell-toggled(self.checked); }
                    }
                    Text { text: "若搬移了程式位置，請重新啟用一次。"; color: #707070; }
                    HorizontalLayout { alignment: end; Button { text: "關閉"; clicked => { root.action("dialog-close"); } } }
                }
                if root.dialog == "find": VerticalLayout {
                    spacing: 8px;
                    Text { text: root.archive-open ? "在整個壓縮檔中尋找名稱包含：" : "在目前資料夾中尋找名稱包含："; }
                    LineEdit { text <=> root.find-text; accepted => { root.action("find-ok"); } }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button { text: "尋找"; primary: true; clicked => { root.action("find-ok"); } }
                        Button { text: "清除"; clicked => { root.find-text = ""; root.action("find-ok"); } }
                        Button { text: "取消"; clicked => { root.action("dialog-close"); } }
                    }
                }
                if root.dialog == "password": VerticalLayout {
                    spacing: 8px;
                    Text { text: "壓縮檔密碼（用於開啟、解壓縮與測試）："; }
                    LineEdit { input-type: password; text <=> root.archive-password; accepted => { root.action("password-ok"); } }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button { text: "確定"; primary: true; clicked => { root.action("password-ok"); } }
                        Button { text: "取消"; clicked => { root.action("dialog-close"); } }
                    }
                }
            }
        }
    }
}
